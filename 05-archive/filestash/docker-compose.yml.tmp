name: archive-files
services:
  app:
    container_name: archive-files
    image: machines/filestash:latest
    restart: "no"
    env_file:
      - .env
    environment:
      - GD_NO_WIPE_MNT=true
    ports:
      - "8334:8334"
    volumes:
      - filestash_config:/app/data/state
      - ${STORAGE_ROOT}:/mnt/data
    networks:
      - web-network
    deploy:
      resources:
        limits:
          memory: 512M

volumes:
  filestash_config:

networks:
  web-network:
    external: true


# This .env file is used to set environment variables for the Filestash container.

# --- FILESTASH CONFIGURATION ---
# Where the files actually live on your Host
#STORAGE_ROOT=/mnt/Sandisk_SSD_1TB/filestash

# User permissions (Matches your user 'karem')
#PUID=1000
#PGID=1000

# Timezone
#TZ=America/New_York