# --- SECRETS (Never commit these!) ---
.env
*.env
*.key
*.pem

# --- HEAVY DATA & DATABASES ---
# Ignore all 'data' folders in any subdirectory
**/data/

# Specific Immich Database folder
immich/postgres/
immich/model-cache/

# Tailscale State
tailscale/state/

# Nginx Proxy Manager Certificates
nginx-proxy-manager/letsencrypt/

# --- LOGS & JUNK ---
*.log
*.sqlite
.DS_Store

# --- OPENCLAW ---
# Critical config (Tokens, DBs) - NEVER COMMIT
openclaw/openclaw-config/

# Workspace files (Agent's scratchpad) - Optional to commit, but usually noisy
openclaw/openclaw-workspace/

# Ignore the hidden git repo INSIDE the workspace (the agent initializes its own git)
openclaw/openclaw-workspace/.git/

# Ignore build artifacts if you ever rebuild
openclaw/build/
openclaw/dist/
openclaw/node_modules/
